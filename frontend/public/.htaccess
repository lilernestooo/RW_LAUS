# ==============================================================================
# Security Hardening + SPA Routing for RW 95.1 FM
# ==============================================================================

# 1. Disable directory browsing
Options -Indexes

# 2. Block access to hidden files and directories (.env, .git, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Block sensitive configuration, database dumps, logs, and backup files
<FilesMatch "\.(env|sql|log|bak|swp|ini|conf|sh|old|orig|tmp|phps)$">
    Require all denied
</FilesMatch>

# 3b. Include-only PHP files: never requested directly
<FilesMatch "^(config\.php|mysqli_connect.*\.php|email_connect.*\.php)$">
    Require all denied
</FilesMatch>

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always unset X-Powered-By
</IfModule>

# 5. Disable PHP error display (errors should go to log, not the browser)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# 6. Second layer for hidden files (keeps .well-known open for SSL), then SPA routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteCond %{REQUEST_URI} !^/(api|uploads|assets)/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>