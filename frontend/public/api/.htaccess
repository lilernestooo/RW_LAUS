# API folder rules

# No folder listing, and don't auto-run home.php when someone opens /api/
Options -Indexes
DirectoryIndex disabled

# Include-only files: never requested directly
<FilesMatch "^(config\.php|mysqli_connect.*\.php|email_connect.*\.php)$">
    Require all denied
</FilesMatch>

# Never serve hidden files, dumps, logs, backups or config samples
<FilesMatch "^\.|\.(env|sql|log|bak|swp|ini|conf|sh|old|orig|tmp|phps|json|lock|md|yml|xml|dist)$">
    Require all denied
</FilesMatch>