# ==============================================================================
# Environment Configuration Template for RW 95.1 FM Backend
# ==============================================================================

# Database Settings
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Authentication & Security
# Generate a 32+ character random secret (e.g., using: php -r "echo bin2hex(random_bytes(32));")
ADMIN_TOKEN_SECRET=replace_with_a_secure_random_string_at_least_32_characters
UPLOAD_TOKEN=replace_with_upload_token

# Email & SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
CONTACT_TO=dwrw951fm@yahoo.com
CONTACT_FROM=noreply@example.com
CONTACT_FROM_NAME="DWRW Contact Form"
CONTACT_SUBJECT_PREFIX="DWRW Contact Form"
# Optional exact subject override (leave unset to use: "DWRW Contact Form - Sender Name")
# CONTACT_SUBJECT="DWRW Contact Form"

# In production set SMTP_VERIFY_SSL=true (set to false only in local environments without a root CA bundle)
SMTP_VERIFY_SSL=true
SMTP_FORCE_IPV4=false

# Rate Limiting: Max contact submissions per IP per hour
CONTACT_RATE_LIMIT=5

# Optional: Public URL for banner in email templates (prevents webmail attachment icons)
# BANNER_URL=https://yourdomain.com/assets/cropped-NewBanner.jpg

# Optional: Comma-separated list of additional allowed CORS origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
