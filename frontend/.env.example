# Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.

# The full URL to the backend API folder.
# In development this defaults to http://localhost/RW_LAUS/backend/api
# For production, set this to your real domain:
VITE_API_URL=https://rw951.fm/RW_LAUS/public/api
